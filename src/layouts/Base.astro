---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { LOCALES, OG_LOCALE, localeUrl, t, type Locale } from "../i18n/ui";
import { person } from "../data/site";
import defaultOg from "../assets/projects/b2c/home.webp";

// Only the three subsets Mongolian and English text actually use. Ө and Ү
// live in cyrillic-ext, so it is preloaded alongside cyrillic.
import onestLatin from "@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url";
import onestCyr from "@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url";
import onestCyrExt from "@fontsource-variable/onest/files/onest-cyrillic-ext-wght-normal.woff2?url";
import unbLatin from "@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url";
import unbCyr from "@fontsource-variable/unbounded/files/unbounded-cyrillic-wght-normal.woff2?url";
import unbCyrExt from "@fontsource-variable/unbounded/files/unbounded-cyrillic-ext-wght-normal.woff2?url";

interface Props {
  locale: Locale;
  /** Page title without the site name. Omit on the homepage. */
  title?: string;
  description: string;
  /** Locale-less path of this page, e.g. "projects/b2c/". Used for hreflang. */
  path?: string;
  ogImage?: ImageMetadata;
  noindex?: boolean;
}

const { locale, title, description, path = "", ogImage = defaultOg, noindex = false } = Astro.props;

const name = person.name[locale];
const fullTitle = title ? `${title} — ${name}` : `${name} — ${person.role[locale]}`;
const canonical = new URL(localeUrl(locale, path), Astro.site);
const og = await getImage({
  src: ogImage,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "top",
  format: "jpeg",
});
const ogUrl = new URL(og.src, Astro.site);

const RANGE = {
  latin:
    "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD",
  cyrillic: "U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116",
  cyrillicExt: "U+0460-052F,U+1C80-1C8A,U+20B4,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F",
};
const faces = [
  ["Onest", onestLatin, RANGE.latin],
  ["Onest", onestCyr, RANGE.cyrillic],
  ["Onest", onestCyrExt, RANGE.cyrillicExt],
  ["Unbounded", unbLatin, RANGE.latin],
  ["Unbounded", unbCyr, RANGE.cyrillic],
  ["Unbounded", unbCyrExt, RANGE.cyrillicExt],
];
const fontCss = faces
  .map(
    ([family, src, range]) =>
      `@font-face{font-family:"${family}";font-style:normal;font-display:swap;font-weight:100 900;src:url(${src}) format("woff2");unicode-range:${range}}`,
  )
  .join("");
// The first screen uses Onest everywhere and Unbounded for the name. Preload
// the subsets for this page's script; the rest load on demand.
const preload =
  locale === "mn" ? [onestCyr, onestCyrExt, unbCyr, unbCyrExt] : [onestLatin, unbLatin];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localeUrl(l, path), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localeUrl("mn", path), Astro.site)} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#f5f6f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12161f" media="(prefers-color-scheme: dark)" />

    {preload.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <style is:inline set:html={fontCss} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t(locale, "skipToContent")}
    </a>
    <Header locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
