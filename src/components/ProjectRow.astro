---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { domainOf, localeUrl, splitId, t, type Locale } from "../i18n/ui";
import { notches } from "../lib/edges";

interface Props {
  locale: Locale;
  project: CollectionEntry<"projects">;
  /** Position in its list; folders stack by it. */
  index?: number;
  /** Client work is filed as a folder; own work is printed as a ticket. */
  variant?: "folder" | "ticket";
}

const { locale, project, index = 0, variant = "folder" } = Astro.props;
const p = project.data;
const slug = splitId(project.id).slug;
const href = localeUrl(locale, `projects/${slug}/`);
const domain = domainOf(p.url);
const meta = p.kind === "personal" ? `${t(locale, "studyProject")}, ${p.client}` : p.client;
---

<li
  class:list={["row", variant]}
  data-accent={p.accent}
  style={
    variant === "folder"
      ? `--i: ${index}`
      : `--clip-wide: ${notches("vertical", 70, 16)}; --clip-narrow: ${notches("horizontal", 62, 16)}`
  }
>
  {variant === "folder" && (
    <p class="tab">
      {/* Morphs into the case study's <h1> on navigation. */}
      <a class="name display" href={href} style={`view-transition-name: title-${slug}`}>
        {p.title}
      </a>
    </p>
  )}

  <div class="band">
    {variant === "folder" && <p class="category">{p.client}</p>}

    {/* Decorative duplicate of the title link, so it stays out of the tab order. */}
    <a
      class="thumb"
      href={href}
      tabindex="-1"
      aria-hidden="true"
      style={`view-transition-name: cover-${slug}`}
    >
      <Picture
        src={p.cover}
        alt=""
        widths={[480, 640, 960, 1280]}
        sizes="(min-width: 64rem) 50vw, 92vw"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        loading="lazy"
      />
    </a>

    <div class="body">
      {variant === "ticket" && (
        <a class="name display" href={href} style={`view-transition-name: title-${slug}`}>
          {p.title}
        </a>
      )}
      <p class="summary">{p.summary}</p>
      <dl class="meta">
        {variant === "ticket" && (
          <div>
            <dt class="visually-hidden">{t(locale, "client")}</dt>
            <dd>{meta}</dd>
          </div>
        )}
        <div>
          <dt class="visually-hidden">{t(locale, "role")}</dt>
          <dd>{p.role}</dd>
        </div>
        <div>
          <dt class="visually-hidden">{t(locale, "period")}</dt>
          <dd>{p.period}</dd>
        </div>
      </dl>
    </div>

    <p class="actions">
      <a class="btn" href={href}>
        {t(locale, "readCaseStudy")}
      </a>
      <a class="visit" href={p.url} target="_blank" rel="noopener">
        {t(locale, "visitSite", { domain })}
      </a>
    </p>
  </div>
</li>

<style>
  .row {
    color: var(--sheet-ink);
  }

  .row :focus-visible {
    outline-color: var(--sheet-ink);
  }

  .name {
    color: inherit;
    text-decoration: none;
  }

  .summary {
    max-width: 52ch;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .row .btn {
    background: var(--sheet-ink);
    color: var(--accent);
  }

  .visit {
    display: inline-block;
    padding-block: var(--space-2);
    font-weight: var(--weight-strong);
  }

  .thumb {
    display: block;
    overflow: hidden;
  }

  .thumb :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: 0 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .thumb :global(img) {
      transition: scale var(--dur-slow) var(--ease-out-expo);
    }

    .row:hover .thumb :global(img),
    .row:focus-within .thumb :global(img) {
      scale: 1.04;
    }
  }

  /*
   * Folder: a tab with shouldered corners rises from the band's top-left.
   * On wide screens the folders stick in a pile as the page scrolls, each
   * leaving a 64px strip (its tab and the band's top) above the next.
   */
  .tab {
    display: flex;
  }

  .tab .name {
    display: block;
    min-width: 12.5rem;
    padding: 10px 2rem 6px;
    background: var(--accent);
    clip-path: polygon(0 100%, 14px 0, calc(100% - 14px) 0, 100% 100%);
    font-size: var(--step-1);
    line-height: 1.1;
  }

  .tab .name:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .folder .band {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    background: var(--accent);
  }

  .category {
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
  }

  .folder .body {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  @media (min-width: 64rem) {
    .folder {
      position: sticky;
      top: calc(4.5rem + var(--i) * 64px);
    }

    .folder .band {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto 1fr auto;
      column-gap: var(--space-5);
      min-height: min(80svh, 46rem);
      padding: var(--space-5) var(--space-6) var(--space-6);
    }

    .category {
      grid-column: 1 / -1;
      justify-self: end;
    }

    .folder .thumb {
      grid-column: 1 / 8;
      grid-row: 2 / 4;
      align-self: start;
    }

    .folder .body {
      grid-column: 9 / 13;
      grid-row: 2;
    }

    .folder .actions {
      grid-column: 9 / 13;
      grid-row: 3;
    }
  }

  /*
   * Ticket: one filled card about 2.2:1, the stub cut off by two notches
   * and a perforation of round dots.
   */
  .ticket .band {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    background: var(--accent);
    clip-path: var(--clip-narrow);
  }

  .ticket .body {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .ticket .name {
    font-size: var(--step-2);
  }

  .ticket .actions {
    padding-top: var(--space-6);
    border-top: var(--perf) dotted var(--ground);
  }

  @media (min-width: 64rem) {
    .ticket .band {
      grid-template-columns: 5fr 4fr 3fr;
      align-items: stretch;
      gap: var(--space-6);
      aspect-ratio: 2.2 / 1;
      padding: var(--space-6);
      clip-path: var(--clip-wide);
    }

    .ticket .thumb {
      align-self: center;
    }

    .ticket .actions {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      margin-block: calc(-1 * var(--space-6));
      padding: var(--space-6) 0 var(--space-6) var(--space-6);
      border-top: 0;
      border-left: var(--perf) dotted var(--ground);
    }
  }
</style>
