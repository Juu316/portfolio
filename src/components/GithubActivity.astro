---
/**
 * The GitHub contribution calendar, drawn at build time from public data
 * (src/data/github.ts) to look like the one on github.com: GitHub's greens,
 * month and weekday labels, a hover title per day, "Less … More" legend.
 * With a token, also the year's totals and the language mix of public repos.
 * Left out entirely when GitHub can't be read.
 * In the browser, the script below redraws the calendar from a public live API
 * (same numbers as the profile) and shows GitHub's hover bubble per day. If the
 * API fails, the build-time calendar stays, with a native title per day.
 */
import { getGithub } from "../data/github";
import { person } from "../data/site";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const login = new URL(person.github).pathname.split("/").filter(Boolean).pop()!;
const github = await getGithub(login);
const data = github?.calendar;

const intl = locale === "mn" ? "mn-MN" : "en-US";
const monthFmt = new Intl.DateTimeFormat(intl, { month: "short", timeZone: "UTC" });
const dayFmt = new Intl.DateTimeFormat(intl, { month: "short", day: "numeric", timeZone: "UTC" });
const weekdayFmt = new Intl.DateTimeFormat(intl, { weekday: "short", timeZone: "UTC" });
const utc = (date: string) => new Date(`${date}T00:00:00Z`);

/** GitHub's geometry: 10px squares, 3px apart, labels in the margins. */
const CELL = 10;
const GAP = 3;
const STEP = CELL + GAP;
const LEFT = 30;
const TOP = 16;

/** A month label over the first week that starts in a new month, as GitHub does. */
const months: { x: number; label: string }[] = [];
if (data) {
  let last = -1;
  for (let week = 0; week < data.weeks; week++) {
    const first = data.days.filter((d) => d.week === week).sort((a, b) => a.weekday - b.weekday)[0];
    if (!first) continue;
    const month = utc(first.date).getUTCMonth();
    if (month === last) continue;
    last = month;
    const x = LEFT + week * STEP;
    // Skip a label that would crowd the previous one (a partial first week).
    if (months.length && x - months[months.length - 1].x < 3 * STEP) months.pop();
    const label = monthFmt.format(utc(first.date));
    // Skip a label that would run past the right edge (about 5.5 units per character).
    if (x + label.length * 5.5 > LEFT + data.weeks * STEP - GAP) continue;
    months.push({ x, label });
  }
}

/** Mon, Wed, Fri, like GitHub. 2023-01-01 was a Sunday. */
const weekdays = [1, 3, 5].map((row) => ({
  y: TOP + row * STEP + CELL - 1,
  label: weekdayFmt.format(new Date(Date.UTC(2023, 0, 1 + row))),
}));

const num = (n: number) => n.toLocaleString(intl);
const total = data && num(data.total);
/** Text around the number, so the script can update the number alone. */
const [totalBefore, totalAfter] = t(locale, "contributions", { count: "\0" }).split("\0");
const api = `https://github-contributions-api.jogruber.de/v4/${login}?y=last`;
/** Month names for the script, since browsers may lack Mongolian locale data. */
const longFmt = new Intl.DateTimeFormat(intl, { month: "long", day: "numeric", timeZone: "UTC" });
const eachMonth = (fn: (date: Date) => string) =>
  Array.from({ length: 12 }, (_, m) => fn(new Date(Date.UTC(2023, m, 28)))).join("|");
const tipDays = eachMonth((d) => longFmt.format(d).replace("28", "{d}"));
const monthLabels = eachMonth((d) => monthFmt.format(d));

/** Zero totals say nothing, so only non-zero ones are listed. */
const stats = github?.stats
  ? (
      [
        ["statCommits", github.stats.commits],
        ["statPRs", github.stats.pullRequests],
        ["statIssues", github.stats.issues],
        ["statReviews", github.stats.reviews],
        ["statPrivate", github.stats.private],
      ] as const
    ).filter(([, n]) => n > 0)
  : [];
const languages = github?.languages ?? [];
---

{data && (
  <section
    id="activity"
    class="wrap block"
    aria-labelledby="activity-title"
    data-api={api}
    data-intl={intl}
    data-days={tipDays}
    data-months={monthLabels}
    data-label={t(locale, "contributions")}
    data-none={t(locale, "dayNone")}
    data-one={t(locale, "dayOne")}
    data-many={t(locale, "dayContributions")}
  >
    <h2 class="section-title" id="activity-title">
      {t(locale, "activity")}
    </h2>
    <p class="total reveal">
      <a href={person.github} rel="me">
        {totalBefore}
        <span class="count">{total}</span>
        {totalAfter}
      </a>
    </p>
    {/* GitHub's own calendar, drawn the way GitHub draws it (owner's choice). */}
    <div class="calendar reveal" data-ui>
      {/* Focusable so keyboard users can scroll it on phones. */}
      <div
        class="scroller"
        tabindex="0"
        role="region"
        aria-label={t(locale, "contributions", { count: total! })}
      >
        <svg
          viewBox={`0 0 ${LEFT + data.weeks * STEP - GAP} ${TOP + 7 * STEP - GAP}`}
          aria-hidden="true"
          focusable="false"
        >
          {months.map((m) => (
            <text x={m.x} y="9">
              {m.label}
            </text>
          ))}
          {weekdays.map((d) => (
            <text x="0" y={d.y}>
              {d.label}
            </text>
          ))}
          {data.days.map((day) => (
            <rect
              x={LEFT + day.week * STEP}
              y={TOP + day.weekday * STEP}
              width={CELL}
              height={CELL}
              rx="2"
              class={`l${day.level}`}
              data-date={day.date}
              data-count={day.count}
            >
              <title>
                  {t(locale, day.count === 0 ? "dayNone" : day.count === 1 ? "dayOne" : "dayContributions", {
                    count: String(day.count),
                    date: dayFmt.format(utc(day.date)),
                  })}
                </title>
            </rect>
          ))}
        </svg>
      </div>
      <div class="tip" role="tooltip" hidden></div>
      <div class="foot">
        <a href="https://docs.github.com/articles/why-are-my-contributions-not-showing-up-on-my-profile">
          {t(locale, "howWeCount")}
        </a>
        <span class="legend" aria-hidden="true">
          {t(locale, "less")}
          {[0, 1, 2, 3, 4].map((level) => (
            <svg viewBox={`0 0 ${CELL} ${CELL}`}>
              <rect width={CELL} height={CELL} rx="2" class={`l${level}`} />
            </svg>
          ))}
          {t(locale, "more")}
        </span>
      </div>
    </div>

    {stats.length > 0 && (
      <dl class="stats reveal">
        {stats.map(([key, n]) => (
          <div>
            <dt>{t(locale, key)}</dt>
            <dd>{num(n)}</dd>
          </div>
        ))}
      </dl>
    )}

    {languages.length > 0 && (
      <div class="languages reveal">
        <h3>{t(locale, "languagesTitle")}</h3>
        <p class="note">{t(locale, "languagesNote")}</p>
        <div class="bar" aria-hidden="true">
          {languages.map((l) => (
            <span style={`--lang: ${l.color}; flex-grow: ${l.percent}`} />
          ))}
        </div>
        <ul>
          {languages.map((l) => (
            <li style={`--lang: ${l.color}`}>
              <span class="swatch" aria-hidden="true" />
              {l.name || t(locale, "other")} <span class="pct">{l.percent.toFixed(1)}%</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
)}

<script>
  // Mirrors the geometry in the frontmatter.
  const STEP = 13;
  const LEFT = 30;
  const TOP = 16;
  const GAP = 3;

  interface Live {
    total: { lastYear: number };
    contributions: { date: string; count: number; level: number }[];
  }

  // Fetched once; the language switch replaces the section and redraws from it.
  let live: Promise<Live> | undefined;

  function init() {
    const section = document.querySelector<HTMLElement>("#activity");
    const scroller = section?.querySelector<HTMLElement>(".scroller");
    const svg = scroller?.querySelector("svg");
    const tip = section?.querySelector<HTMLElement>(".tip");

    if (section && scroller && svg && tip) {
      const { api, intl, label, none, one, many, days, months } = section.dataset as Record<
        string,
        string
      >;
      const dayNames = days.split("|");
      const monthNames = months.split("|");
      const utc = (date: string) => new Date(`${date}T00:00:00Z`);
      const suffix = ["th", "st", "nd", "rd"];

      /** GitHub's wording: "No contributions on October 12th." */
      const describe = (date: string, count: number) => {
        const d = utc(date).getUTCDate();
        const ordinal = intl.startsWith("en") ? suffix[(d - 20) % 10] || suffix[d] || "th" : "";
        return (count === 0 ? none : count === 1 ? one : many)
          .replace("{date}", dayNames[utc(date).getUTCMonth()].replace("{d}", d + ordinal))
          .replace("{count}", count.toLocaleString(intl));
      };

      // The bubble replaces the native titles.
      for (const title of svg.querySelectorAll("title")) title.remove();

      const box = tip.parentElement!;
      const hide = () => (tip.hidden = true);
      svg.addEventListener("pointerover", (event) => {
        const rect = event.target;
        if (!(rect instanceof SVGRectElement)) return hide();
        tip.textContent = describe(rect.dataset.date!, Number(rect.dataset.count));
        tip.hidden = false;
        const outer = box.getBoundingClientRect();
        const cell = rect.getBoundingClientRect();
        const x = cell.left + cell.width / 2 - outer.left;
        const half = tip.offsetWidth / 2;
        const left = Math.min(Math.max(x, half), outer.width - half);
        tip.style.left = `${left}px`;
        tip.style.top = `${cell.top - outer.top}px`;
        tip.style.setProperty("--arrow", `${x - left}px`);
      });
      svg.addEventListener("pointerleave", hide);
      scroller.addEventListener("scroll", hide, { passive: true });

      live ??= fetch(api, { signal: AbortSignal.timeout(8000) }).then((res) =>
        res.ok ? (res.json() as Promise<Live>) : Promise.reject(),
      );
      live
        .then(({ total, contributions: list }) => {
          const cell = svg.querySelector("rect");
          const month = svg.querySelector("text");
          if (!list?.length || !cell || !month) return;
          const offset = utc(list[0].date).getUTCDay();
          const weeks = Math.ceil((offset + list.length) / 7);
          const right = LEFT + weeks * STEP - GAP;
          svg.setAttribute("viewBox", `0 0 ${right} ${TOP + 7 * STEP - GAP}`);
          // Month labels sit at y=9; weekday labels stay.
          for (const old of svg.querySelectorAll('rect, text[y="9"]')) old.remove();

          // Same month-label rules as the build.
          const months: { x: number; text: string }[] = [];
          let last = -1;
          list.forEach((day, i) => {
            if (i && (offset + i) % 7) return;
            const m = utc(day.date).getUTCMonth();
            if (m === last) return;
            last = m;
            const x = LEFT + Math.floor((offset + i) / 7) * STEP;
            if (months.length && x - months[months.length - 1].x < 3 * STEP) months.pop();
            const text = monthNames[m];
            if (x + text.length * 5.5 <= right) months.push({ x, text });
          });
          for (const { x, text } of months) {
            const node = month.cloneNode() as SVGTextElement;
            node.setAttribute("x", String(x));
            node.setAttribute("y", "9");
            node.textContent = text;
            svg.append(node);
          }

          list.forEach((day, i) => {
            const pos = offset + i;
            const node = cell.cloneNode() as SVGRectElement;
            node.setAttribute("x", String(LEFT + Math.floor(pos / 7) * STEP));
            node.setAttribute("y", String(TOP + (pos % 7) * STEP));
            node.setAttribute("class", `l${day.level}`);
            node.dataset.date = day.date;
            node.dataset.count = String(day.count);
            svg.append(node);
          });

          const count = total.lastYear.toLocaleString(intl);
          section.querySelector(".count")!.textContent = count;
          scroller.setAttribute("aria-label", label.replace("{count}", count));
          section.dataset.live = "";
        })
        .catch(() => {});
    }
  }
  init();
  document.addEventListener("lang:swap", init);
</script>

<style>
  /* GitHub's own calendar greens (owner's choice; not --signal). */
  :global(:root) {
    --gh-0: #151b23;
    --gh-1: #033a16;
    --gh-2: #196c2e;
    --gh-3: #2ea043;
    --gh-4: #56d364;
    --gh-tip: #3d444d;
    --gh-bg: #0d1117;
    --gh-border: #3d444d;
    --gh-text: #9198a1;
  }

  :global(:root[data-theme="light"]) {
    --gh-0: #eff2f5;
    --gh-1: #aceebb;
    --gh-2: #4ac26b;
    --gh-3: #2da44e;
    --gh-4: #116329;
    --gh-tip: #25292e;
    --gh-bg: #ffffff;
    --gh-border: #d1d9e0;
    --gh-text: #59636e;
  }

  .total {
    margin-block: var(--space-4) var(--space-5);
    font-size: var(--step-1);
    font-weight: var(--weight-strong);
  }

  .total a {
    color: var(--ink);
  }

  /* GitHub's box: its own background, border and radius, as on github.com. */
  .calendar {
    position: relative;
    padding: var(--space-4) var(--space-4) var(--space-3);
    border: 1px solid var(--gh-border);
    border-radius: 6px;
    background: var(--gh-bg);
  }

  /* Phones scroll the year sideways, starting at the most recent weeks. */
  .scroller {
    display: flex;
    flex-direction: row-reverse;
    overflow-x: auto;
  }

  .scroller svg {
    flex: none;
    display: block;
    width: 100%;
    min-width: 46rem;
    height: auto;
  }

  text {
    fill: var(--gh-text);
    font-size: 9px;
  }

  .l0 {
    fill: var(--gh-0);
    stroke: color-mix(in srgb, var(--gh-text) 12%, transparent);
  }
  .l1 {
    fill: var(--gh-1);
  }
  .l2 {
    fill: var(--gh-2);
  }
  .l3 {
    fill: var(--gh-3);
  }
  .l4 {
    fill: var(--gh-4);
  }

  /* GitHub's day bubble: above the cell, arrow pointing down at it. */
  .tip {
    position: absolute;
    z-index: 1;
    padding: 0.5em 0.75em;
    border-radius: 6px;
    background: var(--gh-tip);
    color: #fff;
    font-size: 12px;
    white-space: nowrap;
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 8px));
  }

  .tip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: calc(50% + var(--arrow, 0px));
    border: 6px solid transparent;
    border-top-color: var(--gh-tip);
    transform: translateX(-50%);
  }

  .tip[hidden] {
    display: none;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-3);
    font-size: var(--step--1);
    color: var(--gh-text);
  }

  .foot a {
    color: var(--gh-text);
  }

  .legend {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .legend svg {
    width: 10px;
    height: 10px;
  }

  /* The year's totals, each on its own filled block. */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 6px;
    margin-top: var(--space-6);
    font-size: var(--step--1);
  }

  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: var(--space-4);
    background: var(--surface);
  }

  .stats dt {
    color: var(--muted);
  }

  .stats dd {
    font-size: var(--step-1);
    font-weight: var(--weight-display);
    font-variant-numeric: tabular-nums;
  }

  .languages {
    margin-top: var(--space-6);
  }

  .languages h3 {
    font-size: var(--step-0);
    letter-spacing: 0;
  }

  .note {
    color: var(--muted);
    font-size: var(--step--1);
  }

  /* GitHub's language bar: one row of slices, 2px apart. */
  .bar {
    display: flex;
    gap: 2px;
    height: 8px;
    margin-block: var(--space-3);
    overflow: hidden;
    border-radius: 6px;
  }

  .bar span {
    min-width: 2px;
    background: var(--lang);
  }

  .languages ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .languages li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .swatch {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--lang);
  }

  .pct {
    color: var(--muted);
  }
</style>
