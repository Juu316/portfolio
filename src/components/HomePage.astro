---
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectIndex from "./ProjectIndex.astro";
import PersonalProjects from "./PersonalProjects.astro";
import Timeline from "./Timeline.astro";
import Contact from "./Contact.astro";
import GithubActivity from "./GithubActivity.astro";
import SkillLogo from "./SkillLogo.astro";
import { logos } from "../data/logos";
import { domainOf, localeUrl, splitId, t, type Locale } from "../i18n/ui";
import { scallops } from "../lib/edges";
import {
  about,
  availability,
  experience,
  expertise,
  person,
  statement,
  statementText,
} from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const all = (await getCollection("projects", (p) => splitId(p.id).locale === locale)).sort(
  (a, b) => a.data.order - b.data.order,
);
/* Client work fills the index, the terminal and the live-site count; own work gets its own section. */
const projects = all.filter((p) => p.data.kind === "client");
const personal = all.filter((p) => p.data.kind === "personal");
const now = experience.find((entry) => entry.current);
const shipped = projects.map((p) => ({
  domain: domainOf(p.data.url),
  accent: p.data.accent,
  href: p.data.url,
}));
/* The hero picture: each client's site in turn, whole, on desktop and phone (crossfade in CSS). */
const slides = projects.map((p) => ({
  title: p.data.title,
  domain: domainOf(p.data.url),
  accent: p.data.accent,
  cover: p.data.cover,
  coverAlt: p.data.coverAlt,
  mobile: p.data.coverMobile,
  mobileAlt: p.data.coverMobileAlt ?? "",
}));
const cv = `${import.meta.env.BASE_URL}${person.resume}`;
/* The giant word is sized to fill its column: about 0.62em per character. */
const expertiseWord = t(locale, "expertise");
---

<Base locale={locale} description={statementText(locale)}>
  <div class="hero">
    {/* The card: name, what I do, the one action, and the live sites. */}
    <section class="card sheet" aria-labelledby="hero-name">
      <div class="stripe" aria-hidden="true">
        {Array.from({ length: 40 }, () => (
          <i />
        ))}
      </div>
      <div class="card-body">
        {availability && (
          <p class="status enter" style="--i: 0">
            {availability[locale]}
          </p>
        )}
        <h1 id="hero-name" class="display enter" style="--i: 1">
          {person.shortName[locale]}
          <span class="role">{person.role[locale]}</span>
        </h1>
        <p class="statement enter" style="--i: 2">
          {statement[locale].map((part) =>
            typeof part === "string" ? (
              part
            ) : (
              <a href={localeUrl(locale, `projects/${part.slug}/`)} data-accent={part.accent}>
                {part.text}
              </a>
            ),
          )}
        </p>
        <p class="enter" style="--i: 3">
          <a class="btn lime" href="#contact">
            {t(locale, "contact")}
          </a>
        </p>

        {/* Printed like the lines of a receipt. Every value is from src/data/site.ts. */}
        <dl class="facts enter" style="--i: 4">
          <div>
            <dt>{t(locale, "location")}</dt>
            <dd>{person.location[locale]}</dd>
          </div>
          {now && (
            <div>
              <dt>{t(locale, "nowAt")}</dt>
              <dd>{now.org[locale]}</dd>
            </div>
          )}
          <div>
            <dt>{t(locale, "liveSites")}</dt>
            <dd>
              <ul class="shipped">
                {shipped.map((s) => (
                  <li>
                    <a href={s.href} data-accent={s.accent}>
                      {s.domain}
                    </a>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>
      </div>
      <ul class="card-links">
        <li>
          <a href={cv} target="_blank" rel="noopener">
            {t(locale, "viewResume")}
          </a>
        </li>
        <li>
          <a href={person.github} rel="me">
            GitHub
          </a>
        </li>
        <li>
          <a href={`mailto:${person.email}`}>{t(locale, "email")}</a>
        </li>
      </ul>
    </section>

    <div class="room enter" style="--i: 2">
      {slides.map((slide, i) => (
        <figure class="slide" data-accent={slide.accent} style={`--k: ${i}`}>
          <div class="group">
            <Picture
              class="desk"
              src={slide.cover}
              alt={slide.coverAlt}
              widths={[640, 960, 1280, 1920]}
              sizes="(min-width: 64rem) 42vw, 84vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
            />
            {slide.mobile && (
              <Picture
                class="phone"
                src={slide.mobile}
                alt={slide.mobileAlt}
                widths={[240, 360, 480, 720]}
                sizes="(min-width: 64rem) 15vw, 30vw"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading={i === 0 ? "eager" : "lazy"}
              />
            )}
            <figcaption>
              <span class="title">{slide.title}</span>
              {slide.domain}
            </figcaption>
          </div>
        </figure>
      ))}
    </div>
  </div>

  <ProjectIndex locale={locale} projects={projects} />

  {personal.length > 0 && <PersonalProjects locale={locale} projects={personal} />}

  <Timeline locale={locale} />

  <section id="expertise" class="wrap block expertise" aria-labelledby="expertise-title">
    <h2
      class="giant display reveal"
      id="expertise-title"
      style={`--chars: ${[...expertiseWord].length}`}
    >
      {expertiseWord}
    </h2>
    <div class="bars">
      {expertise.map((group, i) => (
        <details class="bar reveal" open={i === 0}>
          <summary>
            <span>{group.group[locale]}</span>
            <span class="count">{group.items.length}</span>
          </summary>
          <ul>
            {group.items.map((item) => (
              <li>
                <span class="logos">
                  {logos[item]?.map((logo) => (
                    <SkillLogo logo={logo} />
                  ))}
                </span>
                {item}
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>
  </section>

  <GithubActivity locale={locale} />

  {/* A letter on one sheet, with a tear-off strip that carries the address. */}
  <section id="about" class="wrap block about" aria-labelledby="about-title">
    <div class="letter sheet reveal" style={`clip-path: ${scallops("bottom", 16, 10)}`}>
      <h2 class="section-title" id="about-title">
        {t(locale, "about")}
      </h2>
      <div class="prose">
        {about[locale].map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <p class="sign">
        {person.name[locale]}
        <span>
          {person.role[locale]}, {person.location[locale]}
        </span>
      </p>
      <p class="tear">
        <a href={`mailto:${person.email}`}>{person.email}</a>
        <a class="btn" href={cv} target="_blank" rel="noopener">
          {t(locale, "viewResume")}
        </a>
      </p>
    </div>
  </section>

  <Contact locale={locale} />
</Base>

<style>
  /* Card and picture side by side, one screen tall, on the page margins. */
  .hero {
    display: grid;
    gap: 12px;
    width: min(100% - 2 * var(--gutter), var(--wrap));
    margin-inline: auto;
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: calc(100svh - 4.5rem - var(--gutter));
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* The printed stripe across the card's head: ink and paper, 28px each. */
  .stripe {
    display: flex;
    height: 56px;
    overflow: hidden;
  }

  .stripe i {
    flex: none;
    width: 28px;
  }

  .stripe i:nth-child(odd) {
    background: var(--sheet-ink);
  }

  .card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    padding: var(--space-7) var(--space-5) var(--space-6);
    text-align: center;
  }

  .status {
    font-weight: var(--weight-strong);
  }

  h1 {
    font-size: var(--step-2);
  }

  .role {
    display: block;
    margin-top: var(--space-3);
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  .statement {
    max-width: 36ch;
  }

  /* The clients in the sentence link to their case studies, in their colour. */
  .statement a {
    color: var(--accent-text);
    font-weight: var(--weight-strong);
    text-decoration-thickness: 2px;
  }

  .facts {
    display: grid;
    gap: var(--space-2);
    width: min(100%, 30rem);
    margin-top: var(--space-4);
    text-align: left;
    font-variant-numeric: tabular-nums;
  }

  .facts > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    background: var(--sheet-2);
  }

  .facts dt {
    color: var(--sheet-muted);
  }

  .facts dd {
    font-weight: var(--weight-strong);
    text-align: right;
  }

  .shipped {
    display: grid;
    padding: 0;
    list-style: none;
  }

  /* 24px tall, so the links stay easy to tap. */
  .shipped a {
    display: inline-block;
    min-height: 24px;
    line-height: 24px;
    color: var(--accent-text);
    text-decoration: none;
  }

  .shipped a:hover {
    text-decoration: underline;
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    padding: 0 var(--space-5) var(--space-6);
    list-style: none;
    font-size: var(--step--1);
  }

  .card-links a {
    display: inline-block;
    padding-block: var(--space-2);
  }

  /*
   * The client sites, one after another, each shown whole on a field of its
   * own colour: the desktop page and the phone page overlapping as one group,
   * centred in the panel. The group is a square sized by the panel's shorter
   * side (container units), so nothing is cropped or pushed to an edge.
   */
  .room {
    position: relative;
    overflow: hidden;
    container-type: size;
    height: 44svh;
    background: var(--surface);
  }

  @media (min-width: 64rem) {
    .room {
      position: sticky;
      top: 4.5rem;
      height: calc(100svh - 4.5rem - var(--gutter));
    }
  }

  .slide {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--sheet-ink);
  }

  /* Waiting slides are hidden, not just transparent, so their text is never read through. */
  .slide:not(:first-child) {
    opacity: 0;
    visibility: hidden;
  }

  .group {
    position: relative;
    width: min(84cqw, 84cqh);
    aspect-ratio: 1;
  }

  /* Desktop page across the top, phone page over its lower-right corner. */
  .group :global(.desk) {
    position: absolute;
    top: 0;
    left: 0;
    width: 92%;
    height: auto;
  }

  .group:not(:has(.phone)) :global(.desk) {
    top: 50%;
    translate: 0 -50%;
  }

  .group :global(.phone) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 30%;
    height: auto;
  }

  /* The name sits in the group's empty corner, under the desktop page. */
  figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: 62%;
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
  }

  figcaption .title {
    display: block;
    font-size: var(--step-1);
    font-weight: var(--weight-display);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  /* Each site holds about six seconds, then the next fades in over 1.6s. */
  @keyframes slide {
    0% {
      opacity: 0;
      visibility: hidden;
    }
    0.1% {
      visibility: visible;
    }
    6.7%,
    25% {
      opacity: 1;
      visibility: visible;
    }
    31.7%,
    100% {
      opacity: 0;
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide:not(:first-child) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .slide:not(:first-child) {
      animation: slide 24s var(--ease) infinite backwards;
      animation-delay: calc(var(--k) * 6s - 1.6s);
    }

    .group :global(.phone) {
      transition: translate var(--dur-slow) var(--ease-out-expo);
    }

    .room:hover .group :global(.phone) {
      translate: 0 -12px;
    }
  }

  @media (max-width: 63.99rem) {
    /* On a phone the picture comes first and the card overlaps its foot. */
    .room {
      order: -1;
    }

    /*
     * A panel a little taller than wide, so the group can use nearly the full
     * width; its foot stays clear of the card, which overlaps it by 24px.
     */
    .room {
      height: auto;
      aspect-ratio: 1 / 1.1;
      max-height: 64svh;
    }

    .group {
      width: min(94cqw, calc(100cqh - 48px));
      margin-bottom: 24px;
    }

    .card {
      margin-top: -24px;
      position: relative;
      margin-inline: 12px;
    }

    .stripe {
      height: 40px;
    }
  }

  /* Expertise: one word filling the column, then a stack of filled bars. */
  .expertise {
    max-width: 40rem;
    container-type: inline-size;
  }

  .giant {
    font-size: calc(100cqi / (var(--chars) * 0.6));
    line-height: 0.8;
    white-space: nowrap;
  }

  .bars {
    display: grid;
    gap: 6px;
    margin-top: var(--space-5);
  }

  .bar {
    background: var(--surface);
  }

  summary {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 56px;
    padding: 0 18px;
    font-weight: var(--weight-strong);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .count {
    margin-left: auto;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* The plus turns into a minus when the bar is open. */
  summary::after {
    content: "+";
    width: 1em;
    font-size: var(--step-1);
    line-height: 1;
    text-align: center;
    transition: rotate var(--dur-fast) var(--ease);
  }

  details[open] summary::after {
    content: "\2212";
  }

  .bar ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 14px var(--space-5);
    padding: 4px 20px 20px;
    list-style: none;
  }

  /* Closed bars keep their list out of layout entirely. */
  .bar:not([open]) ul {
    display: none;
  }

  .bar li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Holds the slot open for text-only items so the labels line up. */
  .logos {
    display: inline-flex;
    gap: var(--space-1);
    min-width: 1.1em;
  }

  /* About: the letter sheet, centred, with its tear-off strip. */
  .letter {
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--space-7) var(--space-7) 0;
  }

  .letter .prose {
    margin-top: var(--space-6);
    line-height: 1.55;
  }

  .sign {
    margin-top: var(--space-6);
    font-size: var(--step-1);
    font-weight: var(--weight-display);
    letter-spacing: -0.01em;
  }

  .sign span {
    display: block;
    font-size: var(--step--1);
    font-weight: var(--weight-text);
    letter-spacing: 0;
    color: var(--sheet-muted);
  }

  /* The perforation: a row of round dots in the ground colour. */
  .tear {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin: var(--space-7) calc(-1 * var(--space-7)) 0;
    padding: var(--space-5) var(--space-7) calc(var(--space-6) + 10px);
    border-top: var(--perf) dotted var(--ground);
    font-weight: var(--weight-strong);
  }

  @media (max-width: 47.99rem) {
    .letter {
      padding: var(--space-6) var(--space-5) 0;
    }

    .tear {
      margin-inline: calc(-1 * var(--space-5));
      padding-inline: var(--space-5);
    }

    .tear .btn {
      width: 100%;
    }
  }
</style>
