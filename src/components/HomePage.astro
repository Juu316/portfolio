---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectIndex from "./ProjectIndex.astro";
import Contact from "./Contact.astro";
import Flag from "./Flag.astro";
import { splitId, t, type Locale } from "../i18n/ui";
import {
  about,
  availability,
  education,
  experience,
  expertise,
  languages,
  person,
  statement,
} from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projects = (await getCollection("projects", (p) => splitId(p.id).locale === locale)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base locale={locale} description={statement[locale]}>
  <div class="hero wrap">
    <section class="intro" aria-labelledby="hero-name">
      <h1 id="hero-name" class="display">
        {person.name[locale]}
      </h1>
      <p class="role">
        {person.role[locale]}, {person.location[locale]}
      </p>
      <a
        class="resume"
        href={`${import.meta.env.BASE_URL}${person.resume}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        {/* Lucide "external-link" icon. */}
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M15 3h6v6"></path>
          <path d="M10 14 21 3"></path>
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        </svg>
        {t(locale, "viewResume")}
      </a>
      <p class="statement">{statement[locale]}</p>
      {availability && <p class="cta">{availability[locale]}</p>}
    </section>

    <section id="background" aria-labelledby="background-title">
      <h2 class="section-title" id="background-title">
        {t(locale, "background")}
      </h2>
      {/* Radio-driven tabs: no client JS, arrow keys switch between them. */}
      <div class="tabs">
        <input type="radio" name="bg-tab" id="tab-work" class="visually-hidden" checked />
        <input type="radio" name="bg-tab" id="tab-education" class="visually-hidden" />
        <div class="switch">
          <label for="tab-work">{t(locale, "experience")}</label>
          <label for="tab-education">{t(locale, "education")}</label>
        </div>
        <div class="card">
          {[
            { key: "work", entries: experience },
            { key: "education", entries: education },
          ].map((list) => (
            <ol class:list={["timeline", list.key]}>
              {list.entries.map((entry) => (
                <li>
                  <h3>{entry.org[locale]}</h3>
                  <p class="meta">
                    <span>{entry.role[locale]}</span>
                    <span class="period">
                      {typeof entry.period === "string" ? entry.period : entry.period[locale]}
                    </span>
                  </p>
                  {entry.points && (
                    <ul>
                      {entry.points[locale].map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ol>
          ))}
        </div>
      </div>
      <p class="languages">
        <strong>{t(locale, "languages")}:</strong>
        {languages.map((language) => (
          <span class="language">
            <Flag code={language.flag} />
            {language.text[locale]}
          </span>
        ))}
      </p>
    </section>
  </div>

  <ProjectIndex locale={locale} projects={projects} />

  <section id="expertise" class="wrap block" aria-labelledby="expertise-title">
    <h2 class="section-title" id="expertise-title">
      {t(locale, "expertise")}
    </h2>
    <dl class="skills">
      {expertise.map((group) => (
        <div>
          <dt>{group.group[locale]}</dt>
          {group.items.map((item) => (
            <dd>{item}</dd>
          ))}
        </div>
      ))}
    </dl>
  </section>

  <section id="about" class="wrap block" aria-labelledby="about-title">
    <h2 class="section-title" id="about-title">
      {t(locale, "about")}
    </h2>
    <div class="about prose">
      {about[locale].map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </section>

  <Contact locale={locale} />
</Base>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-7);
  }

  #background {
    margin-top: var(--space-7);
  }

  /* Desktop: the timeline sits beside the intro. */
  @media (min-width: 64rem) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 32rem);
      gap: var(--space-7);
      align-items: start;
    }

    #background {
      margin-top: 0;
    }
  }

  h1 {
    font-size: var(--step-3);
    line-height: 1.1;
  }

  .role {
    margin-top: var(--space-4);
    font-weight: 600;
  }

  .resume {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }

  .resume:hover {
    text-decoration: underline;
  }

  .resume svg {
    width: 1.1em;
    height: 1.1em;
  }

  .statement {
    margin-top: var(--space-2);
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .block {
    margin-top: var(--space-8);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--space-6) var(--space-5);
  }

  dt {
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  dd {
    color: var(--muted);
  }

  .tabs {
    max-width: 48rem;
  }

  .switch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-1);
    padding: var(--space-1);
    margin-bottom: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-frame);
  }

  .switch label {
    padding: var(--space-2) var(--space-3);
    white-space: nowrap;
    border-radius: calc(var(--radius-frame) - 4px);
    color: var(--muted);
    text-align: center;
    cursor: pointer;
  }

  .switch label:hover {
    color: var(--ink);
  }

  #tab-work:checked ~ .switch [for="tab-work"],
  #tab-education:checked ~ .switch [for="tab-education"] {
    background: var(--paper);
    color: var(--ink);
    font-weight: 600;
  }

  #tab-work:focus-visible ~ .switch [for="tab-work"],
  #tab-education:focus-visible ~ .switch [for="tab-education"] {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .card {
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-frame);
  }

  @media (max-width: 29.99rem) {
    .switch {
      font-size: var(--step--1);
    }
  }

  @media (min-width: 40rem) {
    .card {
      padding: var(--space-5);
    }
  }

  #tab-work:checked ~ .card .education,
  #tab-education:checked ~ .card .work {
    display: none;
  }

  .timeline {
    position: relative;
    margin: 0;
    padding: 0 0 0 var(--space-5);
    list-style: none;
  }

  /* The vertical line the dots sit on. */
  .timeline::before {
    content: "";
    position: absolute;
    inset-block: 0.5rem;
    left: 0.3rem;
    width: 1px;
    background: var(--rule);
  }

  .timeline > li {
    position: relative;
  }

  .timeline > li + li {
    margin-top: var(--space-6);
  }

  .timeline > li::before {
    content: "";
    position: absolute;
    top: 0.45em;
    left: calc(-1 * var(--space-5));
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--ink);
  }

  .timeline h3 {
    font-size: var(--step-1);
    font-weight: 600;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-4);
    margin-top: var(--space-1);
    color: var(--muted);
  }

  .period {
    white-space: nowrap;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .timeline ul {
    margin: var(--space-2) 0 0;
    padding-left: var(--space-5);
    list-style: disc;
  }

  .timeline ul li + li {
    margin-top: var(--space-1);
  }

  .languages {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-5);
  }

  .language {
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .about {
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
