---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectIndex from "./ProjectIndex.astro";
import Timeline from "./Timeline.astro";
import Contact from "./Contact.astro";
import { domainOf, localeUrl, splitId, t, type Locale } from "../i18n/ui";
import {
  about,
  availability,
  experience,
  expertise,
  person,
  statement,
  statementText,
} from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projects = (await getCollection("projects", (p) => splitId(p.id).locale === locale)).sort(
  (a, b) => a.data.order - b.data.order,
);
const now = experience.find((entry) => entry.current);
const shipped = projects.map((p) => ({
  domain: domainOf(p.data.url),
  accent: p.data.accent,
  href: localeUrl(locale, `projects/${splitId(p.id).slug}/`),
}));
---

<Base locale={locale} description={statementText(locale)}>
  <div class="hero wrap">
    <section class="intro" aria-labelledby="hero-name">
      <p class="status enter" style="--i: 0">
        <span class="dot" aria-hidden="true"></span>
        {t(locale, "locationValue")}
        {availability && <span class="available">{availability[locale]}</span>}
      </p>
      <h1 id="hero-name" class="enter" style="--i: 1">
        {person.name[locale]}
        <span class="role">{person.role[locale]}</span>
      </h1>
      <p class="statement display enter" style="--i: 2">
        {statement[locale].map((part) =>
          typeof part === "string" ? (
            part
          ) : (
            <a href={localeUrl(locale, `projects/${part.slug}/`)} data-accent={part.accent}>
              {part.text}
            </a>
          ),
        )}
      </p>
      <p class="ctas enter" style="--i: 3">
        <a class="btn-pill primary" href="#work">
          {t(locale, "work")}
        </a>
        <a class="underline-grow" href="#contact">
          {t(locale, "contact")}
        </a>
      </p>
    </section>

    {/* Every line is a fact from src/data/site.ts or the project files. */}
    <figure class="terminal enter" style="--i: 3" aria-label={t(locale, "terminalLabel")}>
      <div class="term-bar" aria-hidden="true">
        <span class="lights">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span>juu@debian</span>
      </div>
      <div class="term-body">
        <p class="cmd">
          <span aria-hidden="true">$ </span>whoami
        </p>
        <p class="out">
          {person.role[locale]}, {person.location[locale]}
        </p>
        {now && (
          <>
            <p class="cmd">
              <span aria-hidden="true">$ </span>cat now
            </p>
            <p class="out">
              {now.org[locale]}, {typeof now.period === "string" ? now.period : now.period[locale]}
            </p>
          </>
        )}
        <p class="cmd">
          <span aria-hidden="true">$ </span>ls ~/shipped
        </p>
        <p class="out shipped">
          {shipped.map((s) => (
            <a href={s.href} data-accent={s.accent}>
              {s.domain}
            </a>
          ))}
        </p>
        <p class="cmd">
          <span aria-hidden="true">$ </span>uname -o
        </p>
        {/* src: owner CV ("works on Debian Linux"). */}
        <p class="out">GNU/Linux (Debian)</p>
        <p class="cmd" aria-hidden="true">
          $ <span class="caret"></span>
        </p>
      </div>
    </figure>

    <dl class="facts enter" style="--i: 4">
      <div>
        <dt>{t(locale, "location")}</dt>
        <dd>{t(locale, "locationValue")}</dd>
      </div>
      {now && (
        <div>
          <dt>{t(locale, "nowAt")}</dt>
          <dd>{now.org[locale]}</dd>
        </div>
      )}
      <div>
        <dt>{t(locale, "liveSites")}</dt>
        <dd>{projects.length}</dd>
      </div>
    </dl>
  </div>

  <ProjectIndex locale={locale} projects={projects} />

  <Timeline locale={locale} />

  <section id="expertise" class="wrap block" aria-labelledby="expertise-title">
    <h2 class="section-title" id="expertise-title">
      {t(locale, "expertise")}
    </h2>
    <dl class="skills">
      {expertise.map((group) => (
        <div class="reveal">
          <dt>{group.group[locale]}</dt>
          {group.items.map((item) => (
            <dd>{item}</dd>
          ))}
        </div>
      ))}
    </dl>
  </section>

  <section id="about" class="wrap block" aria-labelledby="about-title">
    <h2 class="section-title" id="about-title">
      {t(locale, "about")}
    </h2>
    <div class="about prose">
      {about[locale].map((paragraph) => (
        <p class="reveal">{paragraph}</p>
      ))}
    </div>
  </section>

  <Contact locale={locale} />
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-7) var(--space-8);
  }

  /* Desktop: the sentence on the left, the terminal beside it. */
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      padding-top: var(--space-8);
    }

    .facts {
      grid-column: 1 / -1;
    }
  }

  .status {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--signal) 25%, transparent);
  }

  .available {
    color: var(--signal);
  }

  h1 {
    margin-top: var(--space-5);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
  }

  .role {
    display: block;
    font-weight: var(--weight-text);
    color: var(--muted);
  }

  /* The one loud thing on the page. */
  .statement {
    margin-top: var(--space-5);
    max-width: 22ch;
    font-size: clamp(1.9rem, 1.15rem + 2.7vw, 3.5rem);
    line-height: 1.06;
    text-wrap: balance;
  }

  /* The clients in the sentence link to their case studies, underlined in their colour. */
  .statement a {
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.12em;
    transition: color var(--dur-fast) var(--ease);
  }

  .statement a:hover {
    color: var(--accent);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-6);
  }

  .ctas .btn-pill {
    padding: var(--space-3) var(--space-5);
  }

  .ctas .underline-grow {
    font-weight: 500;
  }

  .terminal {
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--radius-frame);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    box-shadow: var(--shadow-float);
    font-family: var(--font-code);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.8rem;
  }

  .lights {
    display: inline-flex;
    gap: 6px;
  }

  .lights i {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--rule);
  }

  .term-body {
    padding: var(--space-4) var(--space-5) var(--space-5);
    overflow-wrap: anywhere;
  }

  .cmd span {
    color: var(--signal);
  }

  .cmd + .out {
    color: var(--muted);
  }

  .out + .cmd {
    margin-top: var(--space-2);
  }

  .shipped {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
  }

  /* 24px tall, so the links stay easy to tap when they wrap onto two lines. */
  .shipped a {
    display: inline-block;
    min-height: 24px;
    line-height: 24px;
    color: var(--accent);
    text-decoration: none;
  }

  .shipped a:hover {
    text-decoration: underline;
  }

  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--muted);
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: blink 1.1s steps(1) infinite;
    }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
  }

  .facts dt {
    color: var(--muted);
  }

  .facts dd {
    margin-top: var(--space-1);
    font-size: var(--step-0);
    font-weight: 500;
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--space-6) var(--space-5);
  }

  .skills dt {
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .skills dd {
    color: var(--muted);
  }

  .about {
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
