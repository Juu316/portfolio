---
import { localeUrl, otherLocale, t, type Locale } from "../i18n/ui";
import Flag from "./Flag.astro";
import Socials from "./Socials.astro";

interface Props {
  locale: Locale;
  /** Locale-less path of the current page, so the switch keeps you in place. */
  path: string;
}

const { locale, path } = Astro.props;
const home = localeUrl(locale);
const other = otherLocale(locale);
const links = [
  { href: `${home}#about`, label: t(locale, "about") },
  { href: `${home}#contact`, label: t(locale, "contact") },
];
---

<header class="site-header">
  <div class="wrap inner">
    <nav aria-label={t(locale, "navLabel")}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <Socials email github />
    <a
      class="lang"
      href={localeUrl(other, path)}
      hreflang={other}
      lang={other}
      aria-label={t(locale, "switchLanguageLabel")}
    >
      <Flag code={other === "mn" ? "MN" : "GB"} />
      <span class="full">{t(locale, "switchLanguage")}</span>
      <span class="short">{t(locale, "switchLanguageShort")}</span>
    </a>
    <!-- Shown and wired up by CursorBuddy.astro where the buddy can run. -->
    <button
      class="buddy-toggle"
      type="button"
      hidden
      data-cursor-toggle
      aria-pressed="true"
      aria-label={t(locale, "cursorBuddyOn")}
      data-label-on={t(locale, "cursorBuddyOn")}
      data-label-off={t(locale, "cursorBuddyOff")}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect x="3" y="9" width="4" height="9" rx="1.5"></rect>
        <path d="M13 2a6 6 0 0 0-6 6v12.5A1.5 1.5 0 0 0 8.5 22h2a1.5 1.5 0 0 0 1.5-1.5V19h2v1.5a1.5 1.5 0 0 0 1.5 1.5h2a1.5 1.5 0 0 0 1.5-1.5V8a6 6 0 0 0-6-6Z"></path>
        <rect class="visor" x="12" y="6" width="9" height="5" rx="2.5"></rect>
        <g class="strike">
          <path class="halo" d="M3 3l18 18"></path>
          <path d="M3 3l18 18"></path>
        </g>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rule);
    font-size: var(--step--1);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-3);
  }

  ul {
    display: flex;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  nav a,
  .lang {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  .lang:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding-left: var(--space-5);
    border-left: 1px solid var(--rule);
  }

  .short {
    display: none;
  }

  .buddy-toggle {
    display: inline-flex;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  .buddy-toggle[hidden] {
    display: none;
  }

  .buddy-toggle[aria-pressed="false"] {
    color: var(--muted);
  }

  .buddy-toggle:hover {
    color: var(--ink);
  }

  .buddy-toggle svg {
    width: 1.5em;
    height: 1.5em;
    fill: currentColor;
  }

  .visor {
    fill: var(--paper);
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .strike {
    display: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .strike .halo {
    stroke: var(--paper);
    stroke-width: 5;
  }

  .buddy-toggle[aria-pressed="false"] .strike {
    display: inline;
  }

  /*
   * Below desktop the header keeps only the nav and the language switch on
   * one row; the socials are repeated in the contact section and the footer.
   */
  @media (max-width: 63.99rem) {
    .inner {
      flex-wrap: nowrap;
      gap: var(--space-5);
    }

    .inner :global(.socials) {
      display: none;
    }
  }

  @media (max-width: 47.99rem) {
    .inner {
      gap: var(--space-4);
    }

    ul {
      gap: var(--space-4);
    }

    .lang {
      padding-left: var(--space-4);
    }

    .full {
      display: none;
    }

    .short {
      display: inline;
    }
  }
</style>
