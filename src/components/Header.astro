---
/**
 * A floating bar: transparent over the top of the page, a glass pill once
 * you scroll (CSS scroll timeline; browsers without it always show the
 * pill). Below desktop width the section links, CV and contact move into a
 * <details> menu, so it opens without JavaScript.
 */
import { LOCALES, localeUrl, t, type Locale } from "../i18n/ui";
import { person } from "../data/site";

interface Props {
  locale: Locale;
  /** Locale-less path of the current page, so the switch keeps you in place. */
  path: string;
}

const { locale, path } = Astro.props;
const home = localeUrl(locale);
const links = [
  { href: `${home}#work`, label: t(locale, "work") },
  { href: `${home}#background`, label: t(locale, "experience") },
  { href: `${home}#expertise`, label: t(locale, "expertise") },
  { href: `${home}#about`, label: t(locale, "about") },
];
const cv = `${import.meta.env.BASE_URL}${person.resume}`;
const contact = `${home}#contact`;
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href={home} aria-label={`${person.name[locale]}, ${t(locale, "homeLabel")}`}>
      <span class="dot" aria-hidden="true"></span>
      {person.shortName[locale]}
    </a>

    <nav class="links wide" aria-label={t(locale, "navLabel")}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="tools">
      <div class="lang" role="group" aria-label={t(locale, "languageLabel")}>
        {LOCALES.map((l) =>
          l === locale ? (
            <a href={localeUrl(l, path)} lang={l} aria-current="true">
              {l.toUpperCase()}
            </a>
          ) : (
            <a
              href={localeUrl(l, path)}
              hreflang={l}
              lang={l}
              aria-label={t(locale, "switchLanguageLabel")}
            >
              {l.toUpperCase()}
            </a>
          ),
        )}
      </div>

      {/* Shown and wired up by the script below; without JS the site stays dark. */}
      <button
        class="icon-btn theme-toggle"
        type="button"
        hidden
        data-theme-toggle
        data-label-light={t(locale, "themeToLight")}
        data-label-dark={t(locale, "themeToDark")}
        aria-label={t(locale, "themeToLight")}
      >
        {/* Lucide "sun" (shown in dark mode) and "moon" (shown in light mode). */}
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- Shown and wired up by CursorBuddy.astro where the buddy can run. -->
      <button
        class="icon-btn buddy-toggle"
        type="button"
        hidden
        data-cursor-toggle
        aria-pressed="true"
        aria-label={t(locale, "cursorBuddyOn")}
        data-label-on={t(locale, "cursorBuddyOn")}
        data-label-off={t(locale, "cursorBuddyOff")}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <rect x="3" y="9" width="4" height="9" rx="1.5"></rect>
          <path d="M13 2a6 6 0 0 0-6 6v12.5A1.5 1.5 0 0 0 8.5 22h2a1.5 1.5 0 0 0 1.5-1.5V19h2v1.5a1.5 1.5 0 0 0 1.5 1.5h2a1.5 1.5 0 0 0 1.5-1.5V8a6 6 0 0 0-6-6Z"></path>
          <rect class="visor" x="12" y="6" width="9" height="5" rx="2.5"></rect>
          <g class="strike">
            <path class="halo" d="M3 3l18 18"></path>
            <path d="M3 3l18 18"></path>
          </g>
        </svg>
      </button>

      <a class="btn-pill wide" href={cv} target="_blank" rel="noopener">
        {/* Lucide "external-link". */}
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M15 3h6v6"></path>
          <path d="M10 14 21 3"></path>
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        </svg>
        {t(locale, "viewResume")}
      </a>
      <a class="btn-pill primary wide" href={contact}>
        {t(locale, "contact")}
      </a>

      <details class="menu narrow">
        <summary class="icon-btn" aria-label={t(locale, "menu")}>
          {/* Lucide "menu" and "x". */}
          <svg class="open-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg class="close-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </summary>
        <div class="panel">
          <nav aria-label={t(locale, "navLabel")}>
            <ul>
              {links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="panel-actions">
            <a class="btn-pill" href={cv} target="_blank" rel="noopener">
              {t(locale, "viewResume")}
            </a>
            <a class="btn-pill primary" href={contact}>
              {t(locale, "contact")}
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Theme: the inline script in Base.astro already applied the saved choice.
  // Listeners are delegated because the language switch replaces the header.
  const root = document.documentElement;
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const current = () => (root.dataset.theme === "light" ? "light" : "dark");

  function show(theme: "light" | "dark") {
    if (theme === "light") root.dataset.theme = "light";
    else delete root.dataset.theme;
    if (meta) meta.content = theme === "light" ? "#f2f4f9" : "#0c1226";
    const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    if (toggle) {
      toggle.hidden = false;
      toggle.setAttribute(
        "aria-label",
        (theme === "light" ? toggle.dataset.labelDark : toggle.dataset.labelLight) ?? "",
      );
    }
  }
  show(current());
  document.addEventListener("lang:swap", () => show(current()));

  document.addEventListener("click", (e) => {
    const target = e.target as Element;
    if (target.closest("[data-theme-toggle]")) {
      const next = current() === "light" ? "dark" : "light";
      show(next);
      try {
        localStorage.setItem("theme", next);
      } catch {}
    }
    // Menu: close after picking a link.
    const menu = target.closest<HTMLDetailsElement>(".menu");
    if (menu && target.closest("a")) menu.open = false;
    // Language switch: swap the page in place (plain link without JS).
    const link = target.closest<HTMLAnchorElement>(".lang a[hreflang]");
    if (link && !e.button && !e.ctrlKey && !e.metaKey && !e.shiftKey && !e.altKey) {
      e.preventDefault();
      swap(link.href, true);
    }
  });
  document.addEventListener("keydown", (e) => {
    const menu = document.querySelector<HTMLDetailsElement>(".menu");
    if (e.key === "Escape" && menu?.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });

  // The other locale's page, fetched on hover or focus so the switch is instant.
  const pages = new Map<string, Promise<string>>();
  function load(url: string) {
    let page = pages.get(url);
    if (!page) {
      page = fetch(url).then((res) => (res.ok ? res.text() : Promise.reject()));
      page.catch(() => pages.delete(url));
      pages.set(url, page);
    }
    return page;
  }
  function prefetch(e: Event) {
    const link = (e.target as Element).closest?.<HTMLAnchorElement>(".lang a[hreflang]");
    if (!link) return;
    load(link.href).catch(() => {});
    // Warm the other script's font subset too.
    document.fonts?.load("1em Geologica", link.hreflang === "mn" ? "Өү" : "Aa");
  }
  document.addEventListener("pointerover", prefetch);
  document.addEventListener("focusin", prefetch);

  // Both locales render the same layout, so the element at the top of the
  // viewport has the same position in the new page; keep it where it was.
  const PARTS = [".skip-link", ".site-header", "#main", ".site-footer"];
  const HEAD = 'meta[name="description"], meta[property^="og:"], link[rel="canonical"]';
  let path = location.pathname;

  async function swap(url: string, push: boolean) {
    let doc: Document;
    try {
      doc = new DOMParser().parseFromString(await load(url), "text/html");
    } catch {
      location.href = url;
      return;
    }
    const below = document.querySelector(".site-header")!.getBoundingClientRect().bottom + 8;
    // Anchor: the first in-flow element below that line, or the innermost one
    // it cuts through. Recorded as child indexes from <body>.
    const find = (el: Element): Element | undefined => {
      for (const child of el.children) {
        const { top, bottom } = child.getBoundingClientRect();
        if (bottom <= below || getComputedStyle(child).position == "fixed") continue;
        if (top >= below || !child.children.length) return child;
        const inner = find(child);
        if (inner) return inner;
      }
    };
    let anchor = find(document.body) ?? document.body;
    const steps: number[] = [];
    for (let el = anchor; el != document.body; el = el.parentElement!) {
      steps.unshift([...el.parentElement!.children].indexOf(el));
    }
    const top = anchor.getBoundingClientRect().top;
    const refocus = document.activeElement?.closest(".lang");

    root.dataset.swap = "";
    for (const part of PARTS) {
      const next = doc.querySelector(part);
      if (next) document.querySelector(part)?.replaceWith(next);
    }
    root.lang = doc.documentElement.lang;
    document.title = doc.title;
    for (const old of document.head.querySelectorAll(HEAD)) old.remove();
    document.head.append(...doc.head.querySelectorAll(HEAD));

    anchor = document.body;
    for (const i of steps) {
      const child = anchor.children[i];
      if (!child) break;
      anchor = child;
    }
    scrollBy({ top: anchor.getBoundingClientRect().top - top, behavior: "instant" });

    if (push) history.pushState(null, "", url);
    path = location.pathname;
    document.dispatchEvent(new Event("lang:swap"));
    if (refocus) document.querySelector<HTMLElement>(".lang [aria-current]")?.focus();
  }
  addEventListener("popstate", () => {
    if (location.pathname !== path) swap(location.href, false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    padding: var(--space-3) var(--gutter) 0;
    font-size: var(--step--1);
    view-transition-name: site-header;
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-width: var(--wrap);
    margin-inline: auto;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-5);
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 72%, transparent);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: var(--shadow-float);
  }

  /* Over the top of the page the bar is bare; the pill fills in over the first 80px of scroll. */
  @keyframes glass {
    from {
      border-color: transparent;
      background-color: transparent;
      backdrop-filter: none;
      box-shadow: none;
    }
  }

  @supports (animation-timeline: scroll()) {
    .bar {
      animation: glass linear both;
    }

    /* Separate rule: the minifier would fold the timeline into the shorthand. */
    .site-header .bar {
      animation-timeline: scroll(root);
      animation-range: 0 80px;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    font-size: var(--step-0);
    white-space: nowrap;
    text-decoration: none;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--signal) 25%, transparent);
  }

  ul {
    display: flex;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .links a,
  .panel nav a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .links a:hover,
  .panel nav a:hover {
    color: var(--ink);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }

  /* EN | MN: two links in one track, the current one filled. */
  .lang {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  .lang a {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .lang a:hover {
    color: var(--ink);
  }

  .lang [aria-current] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 0 0 1px var(--rule);
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease);
  }

  .icon-btn:hover {
    color: var(--ink);
  }

  .icon-btn[hidden] {
    display: none;
  }

  .icon-btn svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme-toggle .moon,
  :global([data-theme="light"]) .theme-toggle .sun {
    display: none;
  }

  :global([data-theme="light"]) .theme-toggle .moon {
    display: block;
  }

  /* The crewmate is a filled glyph, unlike the stroked icons. */
  .buddy-toggle svg {
    fill: currentColor;
    stroke: none;
  }

  .buddy-toggle[aria-pressed="true"] {
    color: var(--ink);
  }

  .visor {
    fill: var(--paper);
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .strike {
    display: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .strike .halo {
    stroke: var(--paper);
    stroke-width: 5;
  }

  .buddy-toggle[aria-pressed="false"] .strike {
    display: inline;
  }

  /* Mobile menu. */
  .menu summary {
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu .close-icon,
  .menu[open] .open-icon {
    display: none;
  }

  .menu[open] .close-icon {
    display: block;
  }

  .panel {
    position: absolute;
    top: calc(100% + var(--space-2));
    inset-inline: 0;
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--rule);
    border-radius: 1.25rem;
    background: var(--surface);
    box-shadow: var(--shadow-float);
    font-size: var(--step-0);
  }

  .panel ul {
    display: grid;
    gap: var(--space-3);
  }

  .panel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .panel {
      animation: rise var(--dur-med) var(--ease-out-expo) both;
    }
  }

  /* Wide: everything in the bar. Narrow: brand, language, toggles, menu. */
  .wide {
    display: none;
  }

  @media (min-width: 72rem) {
    .wide {
      display: flex;
    }

    .btn-pill.wide {
      display: inline-flex;
    }

    .narrow {
      display: none;
    }

    .links {
      margin-left: var(--space-5);
    }
  }

  @media (max-width: 29.99rem) {
    .bar {
      gap: var(--space-2);
      padding-left: var(--space-4);
    }

    .brand {
      font-size: var(--step--1);
    }
  }
</style>
