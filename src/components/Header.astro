---
import { localeUrl, otherLocale, t, type Locale } from "../i18n/ui";
import Socials from "./Socials.astro";

interface Props {
  locale: Locale;
  /** Locale-less path of the current page, so the switch keeps you in place. */
  path: string;
}

const { locale, path } = Astro.props;
const home = localeUrl(locale);
const other = otherLocale(locale);
const links = [
  { href: `${home}#work`, label: t(locale, "work") },
  { href: `${home}#about`, label: t(locale, "about") },
  { href: `${home}#contact`, label: t(locale, "contact") },
];
---

<header class="site-header">
  <div class="wrap inner">
    <nav aria-label={t(locale, "navLabel")}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <Socials email github />
    <a
      class="lang"
      href={localeUrl(other, path)}
      hreflang={other}
      lang={other}
      aria-label={t(locale, "switchLanguageLabel")}
    >
      {t(locale, "switchLanguage")}
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    font-size: var(--step--1);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-3);
  }

  ul {
    display: flex;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  nav a,
  .lang {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  .lang:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .lang {
    padding-left: var(--space-5);
    border-left: 1px solid var(--rule);
  }

  /* The switch wraps onto its own row here, so the divider has nothing to divide. */
  @media (max-width: 47.99rem) {
    .lang {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
