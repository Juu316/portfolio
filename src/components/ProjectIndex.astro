---
import type { CollectionEntry } from "astro:content";
import ProjectRow from "./ProjectRow.astro";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  projects: CollectionEntry<"projects">[];
}

const { locale, projects } = Astro.props;
---

<section id="work" class="wrap" aria-labelledby="work-title">
  <h2 class="section-title" id="work-title">
    {t(locale, "selectedWork")}
  </h2>

  <ul class="rows">
    {projects.map((p, i) => (
      <ProjectRow locale={locale} project={p} eager={i === 0} />
    ))}
  </ul>
</section>

<style>
  .rows {
    padding: 0;
    list-style: none;
  }
</style>
