---
/**
 * Work and study printed as one long receipt, year by year, newest first.
 * Certificates follow when the owner has listed any; languages close it.
 */
import Flag from "./Flag.astro";
import { t, type Locale } from "../i18n/ui";
import { certificates, education, experience, languages } from "../data/site";
import { teeth } from "../lib/edges";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const entries = [
  ...experience.map((entry) => ({ ...entry, kind: "work" as const })),
  ...education.map((entry) => ({ ...entry, kind: "study" as const })),
];
// Newest year first; within a year, work before study (sort is stable).
const years = [...new Set(entries.map((e) => e.start))]
  .sort((a, b) => b - a)
  .map((year) => ({
    year,
    entries: entries
      .filter((e) => e.start === year)
      .sort((a, b) => (a.kind === b.kind ? 0 : a.kind === "work" ? -1 : 1)),
  }));
---

<section id="background" class="wrap block" aria-labelledby="background-title">
  <div class="receipt sheet reveal" style={`clip-path: ${teeth({ count: 36, depth: 9 })}`}>
    <h2 class="section-title" id="background-title">
      {t(locale, "background")}
    </h2>

    <ol class="years">
      {years.map((group) => (
        <li class="year">
          <h3 class="year-label">{group.year}</h3>
          <ul class="entries">
            {group.entries.map((entry) => (
              <li class:list={["entry", entry.kind]}>
                <p class="line">
                  <span class="org">{entry.org[locale]}</span>
                  <span class="period">
                    {typeof entry.period === "string" ? entry.period : entry.period[locale]}
                  </span>
                </p>
                <p class="role">
                  {entry.role[locale]}
                  <span class="kind">
                    {" "}
                    · {t(locale, entry.kind === "work" ? "kindWork" : "kindStudy")}
                  </span>
                </p>
                {entry.points && (
                  <ul class="points">
                    {entry.points[locale].map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>

    {certificates.length > 0 && (
      <div class="certificates">
        <h3>{t(locale, "certificates")}</h3>
        <ul>
          {certificates.map((c) => (
            <li>
              {c.url ? <a href={c.url}>{c.name[locale]}</a> : c.name[locale]}
              <span class="period">
                {c.issuer}, {c.year}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="languages">
      <h3>{t(locale, "languages")}</h3>
      {languages.map((language) => (
        <p class="language">
          <Flag code={language.flag} />
          {language.text[locale]}
        </p>
      ))}
    </div>
  </div>
</section>

<style>
  /* A till receipt: narrow, toothed at both ends, set in tidy columns. */
  .receipt {
    max-width: 40rem;
    margin-inline: auto;
    padding: calc(var(--space-7) + 9px) var(--space-7) calc(var(--space-7) + 9px);
    font-variant-numeric: tabular-nums;
  }

  .years {
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .year + .year {
    margin-top: var(--space-6);
  }

  /* The year as the receipt's group total line, on a tone step. */
  .year-label {
    padding: var(--space-2) var(--space-3);
    background: var(--sheet-2);
    font-size: var(--step-0);
    letter-spacing: 0;
  }

  .entries {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-4);
    padding: 0 var(--space-3);
    list-style: none;
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-4);
    font-weight: var(--weight-strong);
  }

  .period {
    white-space: nowrap;
  }

  .role,
  .points {
    color: var(--sheet-muted);
  }

  .points {
    margin-top: var(--space-1);
    padding-left: 1.1em;
  }

  .certificates,
  .languages {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: var(--perf) dotted var(--ground);
  }

  .certificates h3,
  .languages h3 {
    font-size: var(--step-0);
    letter-spacing: 0;
    margin-bottom: var(--space-3);
  }

  .certificates ul {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .certificates li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-4);
  }

  .language {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  .language + .language {
    margin-top: var(--space-2);
  }

  @media (max-width: 47.99rem) {
    .receipt {
      padding-inline: var(--space-5);
    }
  }

  @media (min-width: 64rem) {
    /* Laid on the ground at a slight angle, like a receipt dropped on a desk. */
    .receipt {
      rotate: -1deg;
    }
  }
</style>
