---
/** A screenshot from the live product, on a tone-step mat, with a caption that says what it shows. */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  /** Mobile shots are narrow, so they get a smaller rendered size. */
  device?: "desktop" | "mobile";
}

const { src, alt, caption, device = "desktop" } = Astro.props;
const sizes =
  device === "mobile" ? "(min-width: 48rem) 320px, 80vw" : "(min-width: 90rem) 1100px, 92vw";
const widths = device === "mobile" ? [320, 480, 640] : [640, 960, 1280, 1920];
---

<figure class:list={["shot", "reveal", device]}>
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={["avif", "webp"]}
    fallbackFormat="webp"
  />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .shot :global(img) {
    width: 100%;
  }

  /* The mat keeps a white page apart from the white sheet it sits on. */
  .shot :global(picture) {
    display: block;
    padding: var(--space-3);
    background: var(--sheet-2);
  }

  .mobile {
    max-width: 320px;
  }

  figcaption {
    margin-top: var(--space-3);
    font-size: var(--step--1);
    color: var(--sheet-muted);
    max-width: var(--measure);
  }
</style>
