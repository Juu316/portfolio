---
import { localeUrl, t, type Locale } from "../i18n/ui";
import { availability, contactForm, person, replyTime } from "../data/site";
import { notches } from "../lib/edges";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const thanks = new URL(localeUrl(locale, "thanks/"), Astro.site);
const bare = (url: string) => url.replace(/^https:\/\/(www\.)?/, "").replace(/\/$/, "");
const links = [
  { href: person.github, label: bare(person.github), rel: "me" },
  { href: person.instagram, label: bare(person.instagram), rel: "me noopener" },
  { href: person.facebook, label: bare(person.facebook), rel: "me noopener" },
];
const tel = `+976${person.phone}`;
/* The coupon's two notches: top and bottom on wide screens, the sides on a phone. */
const clip = `--clip-wide: ${notches("vertical", 46, 14)}; --clip-narrow: ${notches("horizontal", 50, 14)}`;
---

{/* A coupon to cut out: the ways to reach me on the left of the perforation, the form on the right. */}
<section id="contact" class="wrap block contact" aria-labelledby="contact-title">
  <div class="coupon reveal" style={clip}>
    <div class="reach">
      <h2 class="section-title" id="contact-title">
        {t(locale, "contact")}
      </h2>

      <div class="channels">
        <div class="channel">
          <p class="label">{t(locale, "email")}</p>
          <a class="value" href={`mailto:${person.email}`}>
            {person.email}
          </a>
          <p class="actions">
            <a class="btn" href={`mailto:${person.email}`}>
              {t(locale, "emailMe")}
            </a>
            <button
              class="btn copy"
              type="button"
              hidden
              data-copy={person.email}
              data-done={t(locale, "copiedEmail")}
              data-copied={t(locale, "copied")}
            >
              {t(locale, "copy")}
            </button>
          </p>
        </div>
        <div class="channel">
          <p class="label">{t(locale, "phone")}</p>
          <a class="value" href={`tel:${tel}`}>
            {person.phoneDisplay}
          </a>
          <p class="actions">
            <a class="btn" href={`tel:${tel}`}>
              {t(locale, "call")}
            </a>
            {person.viber && (
              <a class="btn" href={`viber://chat?number=%2B976${person.phone}`}>
                {t(locale, "openViber")}
              </a>
            )}
            <button
              class="btn copy"
              type="button"
              hidden
              data-copy={tel}
              data-done={t(locale, "copiedPhone")}
              data-copied={t(locale, "copied")}
            >
              {t(locale, "copy")}
            </button>
          </p>
        </div>
      </div>

      {(replyTime || availability) && (
        <dl class="facts">
          {replyTime && (
            <div>
              <dt>{t(locale, "replyTime")}</dt>
              <dd>{replyTime[locale]}</dd>
            </div>
          )}
          {availability && (
            <div>
              <dt>{t(locale, "availabilityLabel")}</dt>
              <dd>{availability[locale]}</dd>
            </div>
          )}
        </dl>
      )}

      <ul class="also">
        {links.map((link) => (
          <li>
            <a href={link.href} rel={link.rel}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="visually-hidden" aria-live="polite" data-copy-status></p>
    </div>

    {/* Plain HTML POST: Web3Forms emails the message and redirects to /thanks/. */}
    <form method="POST" action={contactForm.action} aria-labelledby="form-title">
      <h3 id="form-title">{t(locale, "formHeading")}</h3>
      <input type="hidden" name="access_key" value={contactForm.accessKey} />
      <input type="hidden" name="subject" value={contactForm.subject[locale]} />
      <input type="hidden" name="redirect" value={thanks.href} />
      <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" aria-hidden="true" />

      <label class="visually-hidden" for="cf-name">
        {t(locale, "fieldName")}
      </label>
      <input
        id="cf-name"
        name="name"
        type="text"
        autocomplete="name"
        placeholder={t(locale, "fieldName")}
        required
      />

      <label class="visually-hidden" for="cf-email">
        {t(locale, "fieldEmail")}
      </label>
      <input
        id="cf-email"
        name="email"
        type="email"
        autocomplete="email"
        placeholder={t(locale, "fieldEmail")}
        required
      />

      <label class="visually-hidden" for="cf-message">
        {t(locale, "fieldMessage")}
      </label>
      <textarea
        id="cf-message"
        name="message"
        rows="5"
        placeholder={t(locale, "fieldMessage")}
        required
        minlength="10"
      ></textarea>

      <button class="btn lime" type="submit">
        {t(locale, "send")}
      </button>
    </form>
  </div>
</section>

<script>
  // Copy buttons appear only where the clipboard API exists. Bound again after
  // the language switch replaces the page.
  function init() {
    const status = document.querySelector<HTMLElement>("[data-copy-status]");
    if (!navigator.clipboard) return;
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      const label = button.textContent ?? "";
      button.hidden = false;
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? "");
        } catch {
          return;
        }
        if (status) status.textContent = button.dataset.done ?? "";
        button.textContent = button.dataset.copied ?? label;
        setTimeout(() => {
          button.textContent = label;
          if (status) status.textContent = "";
        }, 2000);
      });
    }
  }
  init();
  document.addEventListener("lang:swap", init);
</script>

<style>
  /* The coupon: one filled card in the field colour, notched and perforated. */
  .coupon {
    display: grid;
    background: var(--field);
    color: var(--field-ink);
    clip-path: var(--clip-narrow);
  }

  .coupon :focus-visible {
    outline-color: var(--lime);
  }

  .reach,
  form {
    padding: var(--space-6) var(--space-5);
  }

  /* The perforation between the two halves: round dots in the ground colour. */
  form {
    border-top: var(--perf) dotted var(--ground);
  }

  @media (min-width: 64rem) {
    .coupon {
      grid-template-columns: 46fr 54fr;
      clip-path: var(--clip-wide);
    }

    .reach,
    form {
      padding: var(--space-7);
    }

    form {
      border-top: 0;
      border-left: var(--perf) dotted var(--ground);
    }
  }

  .channels {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .label {
    font-size: var(--step--1);
    color: var(--field-muted);
  }

  .value {
    display: inline-block;
    margin-top: var(--space-1);
    font-size: var(--step-1);
    font-weight: var(--weight-display);
    letter-spacing: -0.01em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .value:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .coupon .btn:not(.lime) {
    background: var(--field-ink);
    color: var(--field);
  }

  .actions .copy {
    min-width: 6rem;
  }

  .actions .copy[hidden] {
    display: none;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-7);
    margin-top: var(--space-6);
  }

  .facts dd {
    margin-top: var(--space-1);
  }

  .also {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .also a {
    display: inline-block;
    padding-block: var(--space-1);
  }

  form {
    display: grid;
    align-content: start;
    gap: 10px;
  }

  h3 {
    font-size: var(--step-1);
    margin-bottom: var(--space-4);
  }

  input,
  textarea {
    width: 100%;
    min-height: 52px;
    padding: var(--space-3) var(--space-4);
    font: inherit;
    color: var(--field-ink);
    background: color-mix(in srgb, var(--field) 82%, var(--field-ink));
    border: 0;
  }

  input::placeholder,
  textarea::placeholder {
    color: color-mix(in srgb, var(--field-ink) 72%, var(--field));
    opacity: 1;
  }

  textarea {
    resize: vertical;
  }

  /* Honeypot: invisible to people, filled in by naive bots. */
  .botcheck {
    display: none;
  }

  form .btn {
    min-height: 56px;
    margin-top: var(--space-2);
  }
</style>
