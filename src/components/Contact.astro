---
import { localeUrl, t, type Locale } from "../i18n/ui";
import { contactForm, person } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const thanks = new URL(localeUrl(locale, "thanks/"), Astro.site);
const bare = (url: string) => url.replace(/^https:\/\/(www\.)?/, "").replace(/\/$/, "");
const links = [
  { href: person.github, label: bare(person.github), rel: "me" },
  { href: person.instagram, label: bare(person.instagram), rel: "me noopener" },
  { href: person.facebook, label: bare(person.facebook), rel: "me noopener" },
  { href: `tel:+976${person.phone}`, label: person.phone },
];
---

<section id="contact" class="wrap contact" aria-labelledby="contact-title">
  <h2 class="section-title" id="contact-title">
    {t(locale, "contact")}
  </h2>

  <div class="grid">
    <div class="reveal">
      <a class="email display" href={`mailto:${person.email}`}>
        {person.email}
      </a>
      <ul class="also">
        {links.map((link) => (
          <li>
            <a href={link.href} rel={link.rel}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    {/* Plain HTML POST: Web3Forms emails the message and redirects to /thanks/. */}
    <form class="reveal" method="POST" action={contactForm.action} aria-labelledby="form-title">
      <h3 id="form-title">{t(locale, "formHeading")}</h3>
      <input type="hidden" name="access_key" value={contactForm.accessKey} />
      <input type="hidden" name="subject" value={contactForm.subject[locale]} />
      <input type="hidden" name="redirect" value={thanks.href} />
      <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" aria-hidden="true" />

      <label for="cf-name">{t(locale, "fieldName")}</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required />

      <label for="cf-email">{t(locale, "fieldEmail")}</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required />

      <label for="cf-message">{t(locale, "fieldMessage")}</label>
      <textarea id="cf-message" name="message" rows="5" required minlength="10"></textarea>

      <button type="submit">{t(locale, "send")}</button>
    </form>
  </div>
</section>

<style>
  .contact {
    margin-top: var(--space-8);
  }

  .grid {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .email {
    font-size: var(--step-2);
    overflow-wrap: anywhere;
  }

  .also {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
    color: var(--muted);
  }

  form {
    display: grid;
    gap: var(--space-2);
    max-width: 36rem;
  }

  h3 {
    font-size: var(--step-0);
    margin-bottom: var(--space-3);
  }

  label {
    margin-top: var(--space-3);
    font-size: var(--step--1);
    font-weight: 600;
  }

  input,
  textarea {
    width: 100%;
    padding: var(--space-3);
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 6px;
  }

  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--ink);
  }

  textarea {
    resize: vertical;
  }

  /* Honeypot: invisible to people, filled in by naive bots. */
  .botcheck {
    display: none;
  }

  button {
    justify-self: start;
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-6);
    font: inherit;
    font-weight: 600;
    color: var(--paper);
    background: var(--ink);
    border: 0;
    border-radius: 6px;
    cursor: pointer;
  }

  button {
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  button:hover {
    opacity: 0.88;
  }

  @media (prefers-reduced-motion: no-preference) {
    button:hover {
      transform: translateY(-2px);
    }

    button:active {
      transform: translateY(0);
    }
  }
</style>
