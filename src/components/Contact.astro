---
import { localeUrl, t, type Locale } from "../i18n/ui";
import { siFacebook, siGithub, siInstagram, siTelegram } from "simple-icons";
import { availability, contactForm, person, replyTime } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const thanks = new URL(localeUrl(locale, "thanks/"), Astro.site);
const bare = (url: string) => url.replace(/^https:\/\/(www\.)?/, "").replace(/\/$/, "");
const links = [
  { href: person.github, label: bare(person.github), rel: "me", icon: siGithub },
  { href: person.instagram, label: bare(person.instagram), rel: "me noopener", icon: siInstagram },
  { href: person.facebook, label: bare(person.facebook), rel: "me noopener", icon: siFacebook },
  { href: person.telegram, label: bare(person.telegram), rel: "me noopener", icon: siTelegram },
];
const tel = `+976${person.phone}`;
---

<section id="contact" class="wrap contact" aria-labelledby="contact-title">
  <h2 class="section-title" id="contact-title">
    {t(locale, "contact")}
  </h2>

  <div class="grid">
    <div class="reveal">
      <div class="channels">
        <div class="channel">
          <p class="label">{t(locale, "email")}</p>
          <a class="value display" href={`mailto:${person.email}`}>
            {person.email}
          </a>
          <p class="actions">
            <a class="btn-pill" href={`mailto:${person.email}`}>
              {t(locale, "emailMe")}
            </a>
            <button
              class="btn-pill copy"
              type="button"
              hidden
              data-copy={person.email}
              data-done={t(locale, "copiedEmail")}
            >
              {t(locale, "copy")}
            </button>
          </p>
        </div>
        <div class="channel">
          <p class="label">{t(locale, "phone")}</p>
          <a class="value display" href={`tel:${tel}`}>
            {person.phoneDisplay}
          </a>
          <p class="actions">
            <a class="btn-pill" href={`tel:${tel}`}>
              {t(locale, "call")}
            </a>
            {person.viber && (
              <a class="btn-pill" href={`viber://chat?number=%2B976${person.phone}`}>
                {t(locale, "openViber")}
              </a>
            )}
            <button
              class="btn-pill copy"
              type="button"
              hidden
              data-copy={tel}
              data-done={t(locale, "copiedPhone")}
            >
              {t(locale, "copy")}
            </button>
          </p>
        </div>
      </div>

      {(replyTime || availability) && (
        <dl class="facts">
          {replyTime && (
            <div>
              <dt>{t(locale, "replyTime")}</dt>
              <dd>{replyTime[locale]}</dd>
            </div>
          )}
          {availability && (
            <div>
              <dt>{t(locale, "availabilityLabel")}</dt>
              <dd>{availability[locale]}</dd>
            </div>
          )}
        </dl>
      )}

      <ul class="also">
        {links.map((link) => (
          <li>
            <a href={link.href} rel={link.rel}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d={link.icon.path}></path>
              </svg>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="visually-hidden" aria-live="polite" data-copy-status></p>
    </div>

    {/* Plain HTML POST: Web3Forms emails the message and redirects to /thanks/. */}
    <form class="reveal" method="POST" action={contactForm.action} aria-labelledby="form-title">
      <h3 id="form-title">{t(locale, "formHeading")}</h3>
      <input type="hidden" name="access_key" value={contactForm.accessKey} />
      <input type="hidden" name="subject" value={contactForm.subject[locale]} />
      <input type="hidden" name="redirect" value={thanks.href} />
      <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" aria-hidden="true" />

      <label for="cf-name">{t(locale, "fieldName")}</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required />

      <label for="cf-email">{t(locale, "fieldEmail")}</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required />

      <label for="cf-message">{t(locale, "fieldMessage")}</label>
      <textarea id="cf-message" name="message" rows="5" required minlength="10"></textarea>

      <button type="submit">{t(locale, "send")}</button>
    </form>
  </div>
</section>

<script>
  // Copy buttons appear only where the clipboard API exists. Bound again after
  // the language switch replaces the page.
  function init() {
    const status = document.querySelector<HTMLElement>("[data-copy-status]");
    if (!navigator.clipboard) return;
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      const label = button.textContent ?? "";
      button.hidden = false;
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? "");
        } catch {
          return;
        }
        if (status) status.textContent = button.dataset.done ?? "";
        button.textContent = "✓";
        setTimeout(() => {
          button.textContent = label;
          if (status) status.textContent = "";
        }, 2000);
      });
    }
  }
  init();
  document.addEventListener("lang:swap", init);
</script>

<style>
  .contact {
    margin-top: var(--space-8);
  }

  .grid {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .channels {
    display: grid;
    gap: var(--space-6);
  }

  .channel + .channel {
    padding-top: var(--space-6);
    border-top: 1px solid var(--rule);
  }

  .label {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .value {
    display: inline-block;
    margin-top: var(--space-1);
    font-size: var(--step-2);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .value:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--step--1);
  }

  .actions button {
    font: inherit;
    cursor: pointer;
  }

  .actions .copy {
    min-width: 5.5rem;
    justify-content: center;
  }

  .actions .copy[hidden] {
    display: none;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-7);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
  }

  .facts dt {
    color: var(--muted);
  }

  .facts dd {
    margin-top: var(--space-1);
    font-size: var(--step-0);
  }

  .also {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
    color: var(--muted);
  }

  .also a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .also svg {
    width: 1.1em;
    height: 1.1em;
    fill: currentColor;
  }

  form {
    display: grid;
    gap: var(--space-2);
    max-width: 36rem;
  }

  h3 {
    font-size: var(--step-0);
    margin-bottom: var(--space-3);
  }

  label {
    margin-top: var(--space-3);
    font-size: var(--step--1);
    font-weight: 600;
  }

  input,
  textarea {
    width: 100%;
    padding: var(--space-3);
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 6px;
  }

  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--ink);
  }

  textarea {
    resize: vertical;
  }

  /* Honeypot: invisible to people, filled in by naive bots. */
  .botcheck {
    display: none;
  }

  form button {
    justify-self: start;
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-6);
    font: inherit;
    font-weight: 600;
    color: var(--paper);
    background: var(--ink);
    border: 0;
    border-radius: 6px;
    cursor: pointer;
  }

  form button {
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  form button:hover {
    opacity: 0.88;
  }

  @media (prefers-reduced-motion: no-preference) {
    form button:hover {
      transform: translateY(-2px);
    }

    form button:active {
      transform: translateY(0);
    }
  }
</style>
