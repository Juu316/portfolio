---
/**
 * Full-page night sky behind everything, after Aceternity's "Shooting Stars
 * and Stars Background", ported to one plain 2D canvas: a twinkling star
 * field plus a steady stream of shooting stars. Pauses while the tab is
 * hidden; under reduced motion it draws a still star field and nothing flies.
 * Without JS the page keeps its plain dark background. In light mode the
 * canvas is hidden and the loop stops; switching back to dark resumes it.
 */
---

<div class="sky" aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .sky {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: var(--paper);
    view-transition-name: sky;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global([data-theme="light"]) canvas {
    display: none;
  }
</style>

<script>
  // Aceternity's defaults, except that many shooting stars fly at once.
  const STAR_DENSITY = 0.00015; // stars per CSS pixel²
  const SPAWN_MIN = 80; // ms between shooting stars
  const SPAWN_MAX = 300;
  const MAX_SHOOTERS = 12;
  const SPEED_MIN = 10 * 60; // their 10–30 px per frame, in px per second
  const SPEED_MAX = 30 * 60;
  const HEAD = "#9E00FF";
  const TRAIL = "rgba(46, 185, 223, 0)"; // #2EB9DF, faded out

  type Star = { x: number; y: number; r: number; o: number; speed: number };
  type Shooter = { x: number; y: number; angle: number; speed: number; dist: number };

  const canvas = document.querySelector<HTMLCanvasElement>(".sky canvas")!;
  const ctx = canvas.getContext("2d")!;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  let w = 0;
  let h = 0;
  let stars: Star[] = [];
  let shooters: Shooter[] = [];
  let nextSpawn = 0;
  let last = 0;
  let raf = 0;

  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const nw = innerWidth;
    const nh = innerHeight;
    // The mobile address bar changes the height while scrolling; keep the stars.
    const reseed = nw !== w || Math.abs(nh - h) > 150 || !stars.length;
    w = nw;
    h = nh;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    if (reseed) {
      stars = Array.from({ length: Math.floor(w * h * STAR_DENSITY) }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 0.05 + 0.5,
        o: Math.random() * 0.5 + 0.5,
        speed: 0.5 + Math.random() * 0.5,
      }));
    }
    if (still) draw(0);
  }

  // Enters from a random edge and crosses the screen diagonally.
  function spawn(): Shooter {
    const side = Math.floor(Math.random() * 4);
    const along = Math.random() * (side % 2 ? h : w);
    const start = [
      { x: along, y: 0, angle: 45 },
      { x: w, y: along, angle: 135 },
      { x: along, y: h, angle: 225 },
      { x: 0, y: along, angle: 315 },
    ][side];
    return {
      x: start.x,
      y: start.y,
      angle: (start.angle * Math.PI) / 180,
      speed: SPEED_MIN + Math.random() * (SPEED_MAX - SPEED_MIN),
      dist: 0,
    };
  }

  function draw(now: number) {
    ctx.clearRect(0, 0, w, h);
    const t = now / 1000;
    for (const s of stars) {
      const o = still ? s.o : 0.5 + Math.abs(Math.sin(t / s.speed) * 0.5);
      ctx.fillStyle = `rgba(255, 255, 255, ${o})`;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fill();
    }
    for (const s of shooters) {
      // Grows with distance travelled, like the original.
      const len = Math.min(160, 10 * (1 + s.dist / 100));
      ctx.save();
      ctx.translate(s.x, s.y);
      ctx.rotate(s.angle);
      const g = ctx.createLinearGradient(-len, 0, 0, 0);
      g.addColorStop(0, TRAIL);
      g.addColorStop(1, HEAD);
      ctx.fillStyle = g;
      ctx.fillRect(-len, -0.5, len, 1);
      ctx.restore();
    }
  }

  function frame(now: number) {
    raf = requestAnimationFrame(frame);
    const dt = Math.min(0.05, (now - (last || now)) / 1000);
    last = now;
    if (now >= nextSpawn && shooters.length < MAX_SHOOTERS) {
      shooters.push(spawn());
      nextSpawn = now + SPAWN_MIN + Math.random() * (SPAWN_MAX - SPAWN_MIN);
    }
    shooters = shooters.filter((s) => {
      const step = s.speed * dt;
      s.x += step * Math.cos(s.angle);
      s.y += step * Math.sin(s.angle);
      s.dist += step;
      return s.x > -20 && s.x < w + 20 && s.y > -20 && s.y < h + 20;
    });
    draw(now);
  }

  // Animate only while the tab is visible and the theme is dark.
  const root = document.documentElement;
  function sync() {
    cancelAnimationFrame(raf);
    last = 0;
    if (!document.hidden && root.dataset.theme !== "light") raf = requestAnimationFrame(frame);
  }

  resize();
  addEventListener("resize", resize);
  if (!still) {
    sync();
    document.addEventListener("visibilitychange", sync);
    new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ["data-theme"] });
  }
</script>
