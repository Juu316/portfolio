---
import { getCollection } from "astro:content";
import CaseStudy from "../../../components/CaseStudy.astro";
import { splitId } from "../../../i18n/ui";

export async function getStaticPaths() {
  const entries = (await getCollection("projects", (p) => splitId(p.id).locale === "en")).sort(
    (a, b) => a.data.order - b.data.order,
  );
  // Client case studies lead into each other; personal ones lead back into client work.
  const clients = entries.filter((e) => e.data.kind === "client");
  return entries.map((entry) => ({
    params: { slug: splitId(entry.id).slug },
    props: {
      entry,
      next: clients[(clients.indexOf(entry) + 1) % clients.length]!,
    },
  }));
}

const { entry, next } = Astro.props;
---

<CaseStudy entry={entry} next={next} />
