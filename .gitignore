# ---------------------------------------------------------------------------
# Generated by build.js
#
# Not committed: CI runs `node build.js` before uploading to Pages, so the
# live site is always built fresh from source. Run `npm run build` after a
# clone to get a local copy.
#
# Leading slashes anchor these to the repo root — src/main.js is source and
# must stay tracked, only the built /main.js is ignored.
#
# Adding a locale? Add its output directory here too (see LOCALES in
# src/i18n.js). Mongolian is the root language, so its pages land at the
# repo root rather than in a directory of their own.
# ---------------------------------------------------------------------------
/index.html
/404.html
/main.js
/feed.xml
/sitemap.xml
/robots.txt
/og.png
/favicon.svg
/apple-touch-icon.png
/site.webmanifest
/.nojekyll
/blog/
/en/
